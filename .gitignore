# Ignore files with default autosave extension

*.asv



# OSX / *nix default autosave extension

*.m~



# Compiled MEX binaries (all platforms)

*.mex*


# ipynb checkpoints
*.ipynb_checkpoints/*


# Real-data test fixtures (large, derived from real recordings)
tests/fixtures/

# SLURM job logs (tests/run_integration_smoke.sh output/error)
logs/
