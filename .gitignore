# Ignore files with default autosave extension
*.asv

# OSX / *nix default autosave extension
*.m~

# Compiled MEX binaries (all platforms)
*.mex*

# ipynb checkpoints
*.ipynb_checkpoints/*

# Real-data test fixtures (large, derived from real recordings) & parked tests
tests/fixtures/
tests/parked/
tests/stubs/

# SLURM job logs (tests/run_integration_smoke.sh output/error)
logs/
.superpowers/

docs/

# Local claude config
.claude/*
.mcp.json
CLAUDE.local.md

# Scratch results at the repo root
/*.mat
/repro_*.out

# local surveys / tooling
/extreme_rejection_survey/*
/slope_gate_survey/
/variance_ratio_survey/
/local_scripts/
/muscle_deferral_comparison/
/gedai_alpha_analysis/
